{
  // ============================================
  // CRASHBOT SYSTEM - DEBUG CONFIGURATIONS
  // ============================================
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387

  "version": "0.2.0",
  "configurations": [
    // ============================================
    // CRASHBOT V3.0 (Main)
    // ============================================
    {
      "name": "🤖 CrashBot - Main",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/CrashBot/main.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/CrashBot",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/CrashBot"
      },
      "args": []
    },
    {
      "name": "🤖 CrashBot - Headless Mode",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/CrashBot/main.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/CrashBot",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/CrashBot"
      },
      "args": ["--headless"]
    },
    {
      "name": "🤖 CrashBot - Calibrate",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/CrashBot/main.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/CrashBot",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/CrashBot"
      },
      "args": ["--calibrate"]
    },
    {
      "name": "🤖 CrashBot - Debug Mode",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/CrashBot/main.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/CrashBot",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/CrashBot"
      },
      "args": ["--log-level", "DEBUG"],
      "stopOnEntry": false,
      "logToFile": true
    },

    // ============================================
    // CRASH V2.0 (Legacy)
    // ============================================
    {
      "name": "🕹️ Crash v2.0 - Bot Controller",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/Crash/src/bot_controller.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/Crash",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/Crash"
      }
    },

    // ============================================
    // FASTAPI - API BACKEND
    // ============================================
    {
      "name": "🚀 FastAPI - API Server",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--log-level",
        "debug"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/crashbot-platform/api",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/crashbot-platform/api",
        "ENVIRONMENT": "development"
      }
    },
    {
      "name": "🚀 FastAPI - Production Mode",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "8000",
        "--workers",
        "4"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/crashbot-platform/api",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/crashbot-platform/api",
        "ENVIRONMENT": "production"
      }
    },

    // ============================================
    // TESTES - PYTEST
    // ============================================
    {
      "name": "🧪 Pytest - All Tests",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v",
        "--tb=short",
        "--showlocals"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🧪 Pytest - Current File",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "${file}",
        "-v",
        "--tb=short",
        "--showlocals"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🧪 Pytest - Unit Tests Only",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "-v",
        "-m",
        "unit",
        "--tb=short"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🧪 Pytest - With Coverage",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "--cov=CrashBot",
        "--cov=crashbot-platform/api",
        "--cov-report=html",
        "--cov-report=term-missing",
        "-v"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "🧪 Pytest - Failed Tests Only",
      "type": "python",
      "request": "launch",
      "module": "pytest",
      "args": [
        "--lf",
        "-v",
        "--tb=short"
      ],
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}"
    },

    // ============================================
    // ML - MACHINE LEARNING DEBUGGING
    // ============================================
    {
      "name": "🧠 ML - Train LSTM Model",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/CrashBot/engine/ml/predictor_lstm.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/CrashBot",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/CrashBot"
      }
    },
    {
      "name": "🧠 ML - Train RL Agent",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/CrashBot/engine/ml/rl_agent.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/CrashBot",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/CrashBot"
      }
    },
    {
      "name": "🧠 ML - Decision Engine Test",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/CrashBot/engine/ml/decision_engine.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/CrashBot",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/CrashBot"
      }
    },

    // ============================================
    // VISION - COMPUTER VISION DEBUGGING
    // ============================================
    {
      "name": "👁️ Vision - Detector Test",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/CrashBot/engine/vision/detector.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/CrashBot",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/CrashBot"
      }
    },
    {
      "name": "👁️ Vision - OCR Test",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/CrashBot/engine/vision/ocr.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${workspaceFolder}/CrashBot",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/CrashBot"
      }
    },

    // ============================================
    // UTILITIES
    // ============================================
    {
      "name": "🔧 Python - Current File",
      "type": "python",
      "request": "launch",
      "program": "${file}",
      "console": "integratedTerminal",
      "justMyCode": false,
      "cwd": "${fileDirname}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    },
    {
      "name": "🐞 Python - Attach to Process",
      "type": "python",
      "request": "attach",
      "processId": "${command:pickProcess}",
      "justMyCode": false
    },

    // ============================================
    // DOCKER DEBUGGING (se configurado)
    // ============================================
    {
      "name": "🐳 Docker - Attach to Container",
      "type": "python",
      "request": "attach",
      "connect": {
        "host": "localhost",
        "port": 5678
      },
      "pathMappings": [
        {
          "localRoot": "${workspaceFolder}",
          "remoteRoot": "/app"
        }
      ]
    }
  ],

  // ============================================
  // COMPOUND CONFIGURATIONS
  // ============================================
  "compounds": [
    {
      "name": "🎯 Full Stack - Bot + API",
      "configurations": [
        "🤖 CrashBot - Main",
        "🚀 FastAPI - API Server"
      ],
      "presentation": {
        "hidden": false,
        "group": "fullstack",
        "order": 1
      }
    },
    {
      "name": "🧪 Test Suite - Unit + Integration",
      "configurations": [
        "🧪 Pytest - All Tests"
      ],
      "presentation": {
        "hidden": false,
        "group": "testing",
        "order": 2
      }
    },
    {
      "name": "🧠 ML Pipeline - LSTM + RL",
      "configurations": [
        "🧠 ML - Train LSTM Model",
        "🧠 ML - Train RL Agent"
      ],
      "presentation": {
        "hidden": false,
        "group": "ml",
        "order": 3
      },
      "stopAll": true
    }
  ]
}
