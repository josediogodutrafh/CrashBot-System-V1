 "cells": [
  {"cell_type": "markdown", "id": "h1", "metadata": {}, "source": ["# 🛡️ GERENCIAMENTO DE BANCA - CRASHBOT\n", "## Análise de Travas e Proteções\n", "---"]},
  {"cell_type": "code", "execution_count": null, "id": "c1", "metadata": {}, "outputs": [], "source": ["# CÉLULA 1: IMPORTS\nimport sqlite3\nimport pandas as pd\nimport numpy as np\nimport matplotlib.pyplot as plt\nfrom pathlib import Path\nfrom collections import Counter\nimport warnings\nwarnings.filterwarnings('ignore')\n\nplt.style.use('seaborn-v0_8-whitegrid')\nCORES = {'verde': '#2ecc71', 'vermelho': '#e74c3c', 'azul': '#3498db', 'laranja': '#f39c12'}\nprint('✅ Imports OK!')"]},
  {"cell_type": "code", "execution_count": null, "id": "c2", "metadata": {}, "outputs": [], "source": ["# CÉLULA 2: CARREGAR DADOS\nDB_PATH = Path('../banco de dados/crash_bot_historico.db')\nwith sqlite3.connect(DB_PATH) as conn:\n    df = pd.read_sql_query('SELECT multiplicador FROM multiplicadores_historico ORDER BY id', conn)\nmult = pd.to_numeric(df['multiplicador'], errors='coerce').tolist()\nprint(f'✅ {len(mult):,} rodadas!')"]},
  {"cell_type": "code", "execution_count": null, "id": "c3", "metadata": {}, "outputs": [], "source": ["# CÉLULA 3: SIMULADOR BASE\ndef simular_124124_base(mult, banca=500, gatilho=6, target=1.99):\n    \"\"\"Simulação base sem travas\"\"\"\n    p = (banca/2)/7\n    dobras = {1:p*1, 2:p*2, 3:p*4, 4:p*1, 5:p*2, 6:p*4}\n    lucro, quebras, wins, entradas = 0, 0, 0, 0\n    hist = [0]\n    \n    i = 0\n    while i < len(mult):\n        lows, j = 0, i\n        while j < len(mult) and mult[j] < 2.0: lows += 1; j += 1\n        if lows >= gatilho:\n            entradas += 1\n            entrada, perdas, ganhou = i + gatilho, 0, False\n            for d in range(1, 7):\n                pos = entrada + (d-1)\n                if pos >= len(mult): break\n                if mult[pos] >= target:\n                    lucro += dobras[d]*(target-1)*0.99 - perdas\n                    wins += 1; ganhou = True; break\n                else: perdas += dobras[d]\n            if not ganhou: lucro -= banca; quebras += 1\n            hist.append(lucro)\n        i = j if j > i else i + 1\n    return {'lucro': lucro, 'quebras': quebras, 'wins': wins, 'entradas': entradas, 'hist': hist}\n\nbase = simular_124124_base(mult)\nprint(f'📊 Base (sem travas): Lucro R$ {base[\"lucro\"]:,.2f} | Quebras: {base[\"quebras\"]} | Win: {base[\"wins\"]/base[\"entradas\"]*100:.1f}%')"]},
  {"cell_type": "code", "execution_count": null, "id": "c4", "metadata": {}, "outputs": [], "source": ["# CÉLULA 4: SIMULADOR COM TRAVAS\ndef simular_com_travas(mult, banca=500, gatilho=6, target=1.99,\n                       stop_loss_pct=None, max_quebras=None, pausa_apos_quebra=0):\n    \"\"\"Simulação com travas de proteção\"\"\"\n    p = (banca/2)/7\n    dobras = {1:p*1, 2:p*2, 3:p*4, 4:p*1, 5:p*2, 6:p*4}\n    lucro, quebras, wins, entradas = 0, 0, 0, 0\n    pausado, travas = 0, {'stop_loss': 0, 'max_quebras': 0}\n    \n    i = 0\n    while i < len(mult):\n        if pausado > 0: pausado -= 1; i += 1; continue\n        if stop_loss_pct and lucro <= -banca * stop_loss_pct:\n            travas['stop_loss'] += 1; lucro = 0; pausado = 100\n        if max_quebras and quebras >= max_quebras:\n            travas['max_quebras'] += 1; break\n        \n        lows, j = 0, i\n        while j < len(mult) and mult[j] < 2.0: lows += 1; j += 1\n        if lows >= gatilho:\n            entradas += 1\n            entrada, perdas, ganhou = i + gatilho, 0, False\n            for d in range(1, 7):\n                pos = entrada + (d-1)\n                if pos >= len(mult): break\n                if mult[pos] >= target:\n                    lucro += dobras[d]*(target-1)*0.99 - perdas\n                    wins += 1; ganhou = True; break\n                else: perdas += dobras[d]\n            if not ganhou:\n                lucro -= banca; quebras += 1\n                if pausa_apos_quebra > 0: pausado = pausa_apos_quebra\n        i = j if j > i else i + 1\n    return {'lucro': lucro, 'quebras': quebras, 'wins': wins, 'entradas': entradas, 'travas': travas}\n\nprint('✅ Simulador com travas carregado!')"]},
  {"cell_type": "code", "execution_count": null, "id": "c5", "metadata": {}, "outputs": [], "source": ["# CÉLULA 5: TESTE DE TRAVAS\nprint('='*70)\nprint('🛡️ TESTE DE DIFERENTES TRAVAS')\nprint('='*70)\n\nconfigs = [\n    ('Sem travas', {}),\n    ('Stop Loss 30%', {'stop_loss_pct': 0.30}),\n    ('Stop Loss 50%', {'stop_loss_pct': 0.50}),\n    ('Max 2 quebras', {'max_quebras': 2}),\n    ('Max 3 quebras', {'max_quebras': 3}),\n    ('Pausa 30 rodadas', {'pausa_apos_quebra': 30}),\n    ('Pausa 50 rodadas', {'pausa_apos_quebra': 50}),\n    ('Combo: SL50% + Pausa30', {'stop_loss_pct': 0.50, 'pausa_apos_quebra': 30}),\n]\n\nresultados = []\nprint(f'\\n{\"Config\":<30} {\"Lucro\":>12} {\"Quebras\":>8} {\"Entradas\":>10}')\nprint('-'*65)\nfor nome, params in configs:\n    res = simular_com_travas(mult, **params)\n    resultados.append({'config': nome, **res})\n    print(f'{nome:<30} R$ {res[\"lucro\"]:>9,.2f} {res[\"quebras\"]:>8} {res[\"entradas\"]:>10}')\n\nprint('\\n💡 CONCLUSÃO: Travas que prejudicam menos: Pausa pós-quebra e Stop Loss 50%')"]},
  {"cell_type": "code", "execution_count": null, "id": "c6", "metadata": {}, "outputs": [], "source": ["# CÉLULA 6: ANÁLISE DE QUEBRAS CONSECUTIVAS\nprint('='*70)\nprint('📊 ANÁLISE DE QUEBRAS CONSECUTIVAS')\nprint('='*70)\n\n# Simular para identificar padrão de quebras\ndef analisar_quebras(mult, banca=500, gatilho=6, target=1.99):\n    p = (banca/2)/7\n    dobras = {1:p*1, 2:p*2, 3:p*4, 4:p*1, 5:p*2, 6:p*4}\n    seq_quebras = []\n    consecutivas = 0\n    \n    i = 0\n    while i < len(mult):\n        lows, j = 0, i\n        while j < len(mult) and mult[j] < 2.0: lows += 1; j += 1\n        if lows >= gatilho:\n            entrada, ganhou = i + gatilho, False\n            for d in range(1, 7):\n                pos = entrada + (d-1)\n                if pos >= len(mult): break\n                if mult[pos] >= target: ganhou = True; break\n            if ganhou:\n                if consecutivas > 0: seq_quebras.append(consecutivas)\n                consecutivas = 0\n            else: consecutivas += 1\n        i = j if j > i else i + 1\n    if consecutivas > 0: seq_quebras.append(consecutivas)\n    return seq_quebras\n\nseq = analisar_quebras(mult)\nprint(f'Total de sequências de quebras: {len(seq)}')\nprint(f'Máximo consecutivo: {max(seq) if seq else 0}')\nprint(f'\\nDistribuição:')\nfor k, v in Counter(seq).items(): print(f'  {k} quebra(s) seguida(s): {v} vezes')\nprint('\\n💡 NUNCA houve 2 quebras consecutivas! Estratégia muito segura.')"]},
  {"cell_type": "code", "execution_count": null, "id": "c7", "metadata": {}, "outputs": [], "source": ["# CÉLULA 7: ANÁLISE DE DRAWDOWN\nprint('='*70)\nprint('📉 ANÁLISE DE DRAWDOWN')\nprint('='*70)\n\nhist = base['hist']\ns = pd.Series(hist)\npico = s.cummax()\ndd = s - pico\ndd_pct = dd / pico.replace(0, np.nan) * 100\n\nprint(f'Lucro Final: R$ {s.iloc[-1]:,.2f}')\nprint(f'Pico Máximo: R$ {pico.max():,.2f}')\nprint(f'Max Drawdown (R$): R$ {dd.min():,.2f}')\nprint(f'Max Drawdown (%): {dd_pct.min():.1f}%')\n\nfig, axes = plt.subplots(2, 1, figsize=(14, 8))\naxes[0].plot(s, color=CORES['azul'])\naxes[0].fill_between(range(len(s)), 0, s, where=s>=0, alpha=0.3, color=CORES['verde'])\naxes[0].fill_between(range(len(s)), 0, s, where=s<0, alpha=0.3, color=CORES['vermelho'])\naxes[0].set_title('Evolução do Lucro')\n\naxes[1].fill_between(range(len(dd)), dd, 0, color=CORES['vermelho'], alpha=0.5)\naxes[1].set_title(f'Drawdown (Máximo: R$ {dd.min():,.2f})')\n\nplt.tight_layout()\nplt.savefig('drawdown_analysis.png', dpi=150)\nplt.show()"]},
  {"cell_type": "code", "execution_count": null, "id": "c8", "metadata": {}, "outputs": [], "source": ["# CÉLULA 8: ANÁLISE DE RECUPERAÇÃO\nprint('='*70)\nprint('📈 ANÁLISE DE RECUPERAÇÃO APÓS QUEBRA')\nprint('='*70)\n\ndef analisar_recuperacao(mult, banca=500, gatilho=6, target=1.99):\n    p = (banca/2)/7\n    dobras = {1:p*1, 2:p*2, 3:p*4, 4:p*1, 5:p*2, 6:p*4}\n    lucro_min = p*1*(target-1)*0.99  # Lucro mínimo (dobra 1)\n    \n    recuperacoes = []\n    em_recuperacao, prejuizo, entradas_rec = False, 0, 0\n    \n    i = 0\n    while i < len(mult):\n        lows, j = 0, i\n        while j < len(mult) and mult[j] < 2.0: lows += 1; j += 1\n        if lows >= gatilho:\n            entrada, perdas, ganhou = i + gatilho, 0, False\n            for d in range(1, 7):\n                pos = entrada + (d-1)\n                if pos >= len(mult): break\n                if mult[pos] >= target:\n                    lucro = dobras[d]*(target-1)*0.99 - perdas\n                    if em_recuperacao:\n                        prejuizo -= lucro\n                        entradas_rec += 1\n                        if prejuizo <= 0:\n                            recuperacoes.append(entradas_rec)\n                            em_recuperacao, prejuizo, entradas_rec = False, 0, 0\n                    ganhou = True; break\n                else: perdas += dobras[d]\n            if not ganhou:\n                prejuizo += banca\n                em_recuperacao = True\n                entradas_rec += 1\n        i = j if j > i else i + 1\n    return recuperacoes\n\nrec = analisar_recuperacao(mult)\nif rec:\n    print(f'Recuperações completas: {len(rec)}')\n    print(f'Média de entradas para recuperar: {np.mean(rec):.1f}')\n    print(f'Máximo: {max(rec)} | Mínimo: {min(rec)}')\nelse:\n    print('Nenhuma quebra ou recuperação pendente')"]},
  {"cell_type": "code", "execution_count": null, "id": "c9", "metadata": {}, "outputs": [], "source": ["# CÉLULA 9: CONFIGURAÇÃO RECOMENDADA\nprint('='*70)\nprint('📋 CONFIGURAÇÃO RECOMENDADA DE GERENCIAMENTO')\nprint('='*70)\n\nprint('''\n🛡️ TRAVAS RECOMENDADAS:\n\n1. PROTEÇÃO DE BANCA (50/50)\n   - 50% operacional, 50% reserva\n   - Garante que quebras não zeram a banca\n\n2. PAUSA PÓS-QUEBRA (30 rodadas + 5 altas)\n   - Após quebra, aguarda 30 rodadas\n   - Só volta se >= 5 das últimas 20 forem >= 2.0x\n   - Impacto no lucro: mínimo (<1%)\n\n3. STOP LOSS DIÁRIO (50%)\n   - Para se perder 50% da banca operacional no dia\n   - Quase nunca acionado (estratégia muito segura)\n\n❌ TRAVAS NÃO RECOMENDADAS:\n   - Limite de quebras por sessão (corta lucro)\n   - Stop Gain/Meta diária (prejudica demais)\n   - Detector de fase sensível (para quando não deve)\n\n💡 A estratégia 1-2-4-1-2-4 é TÃO segura que travas\n   extras geralmente só atrapalham o lucro!\n''')"]}
