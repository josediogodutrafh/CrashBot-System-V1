    "# --- CÉLULA 9: ANÁLISE DE RECUPERAÇÃO ---\n",
    "\n",
    "print(\"=\"*70)\n",
    "print(\"📈 ANÁLISE DE RECUPERAÇÃO APÓS QUEBRA\")\n",
    "print(\"=\"*70)\n",
    "\n",
    "def analisar_recuperacao(mult, banca=500, gatilho=6, target=1.99):\n",
    "    \"\"\"Analisa quantas entradas são necessárias para recuperar após quebra.\"\"\"\n",
    "    parte = (banca / 2) / 7\n",
    "    dobras = {1: parte*1, 2: parte*2, 3: parte*4, 4: parte*1, 5: parte*2, 6: parte*4}\n",
    "    \n",
    "    recuperacoes = []\n",
    "    em_recuperacao = False\n",
    "    prejuizo = 0\n",
    "    entradas_rec = 0\n",
    "    \n",
    "    i = 0\n",
    "    while i < len(mult):\n",
    "        lows, j = 0, i\n",
    "        while j < len(mult) and mult[j] < 2.0:\n",
    "            lows += 1\n",
    "            j += 1\n",
    "        \n",
    "        if lows >= gatilho:\n",
    "            entrada, perdas, ganhou = i + gatilho, 0, False\n",
    "            \n",
    "            for d in range(1, 7):\n",
    "                pos = entrada + (d - 1)\n",
    "                if pos >= len(mult):\n",
    "                    break\n",
    "                if mult[pos] >= target:\n",
    "                    lucro = dobras[d] * (target - 1) * 0.99 - perdas\n",
    "                    \n",
    "                    if em_recuperacao:\n",
    "                        prejuizo -= lucro\n",
    "                        entradas_rec += 1\n",
    "                        \n",
    "                        if prejuizo <= 0:\n",
    "                            recuperacoes.append(entradas_rec)\n",
    "                            em_recuperacao = False\n",
    "                            prejuizo = 0\n",
    "                            entradas_rec = 0\n",
    "                    \n",
    "                    ganhou = True\n",
    "                    break\n",
    "                else:\n",
    "                    perdas += dobras[d]\n",
    "            \n",
    "            if not ganhou:\n",
    "                prejuizo += banca\n",
    "                em_recuperacao = True\n",
    "                entradas_rec += 1\n",
    "        \n",
    "        i = j if j > i else i + 1\n",
    "    \n",
    "    return recuperacoes\n",
    "\n",
    "recuperacoes = analisar_recuperacao(multiplicadores)\n",
    "\n",
    "if recuperacoes:\n",
    "    print(f\"\\nRecuperações completas: {len(recuperacoes)}\")\n",
    "    print(f\"Média de entradas para recuperar: {np.mean(recuperacoes):.1f}\")\n",
    "    print(f\"Máximo: {max(recuperacoes)} entradas\")\n",
    "    print(f\"Mínimo: {min(recuperacoes)} entradas\")\n",
    "    print(f\"Mediana: {np.median(recuperacoes):.0f} entradas\")\n",
    "else:\n",
    "    print(\"\\nNenhuma recuperação completa registrada.\")"
   ]
