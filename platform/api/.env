# ============================================================================
# CrashBot API - Variaveis de Ambiente (DESENVOLVIMENTO LOCAL)
# ============================================================================
# IMPORTANTE: Este arquivo e apenas para desenvolvimento local
# As credenciais REAIS estao no Render (Environment Variables)
# ============================================================================

# APLICACAO
APP_NAME=CrashBot API
APP_VERSION=2.0.0
DEBUG=True
ENVIRONMENT=development

# SEGURANCA (usar valor real apenas no Render)
SECRET_KEY=local-dev-key-not-for-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# BANCO DE DADOS (usar valor real apenas no Render)
DATABASE_URL=postgresql://user:password@localhost:5432/crashbot_dev

# REDIS
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=False

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:8501"]

# MERCADO PAGO (usar valores reais apenas no Render)
MERCADOPAGO_ACCESS_TOKEN=YOUR_TOKEN_HERE
MERCADOPAGO_PUBLIC_KEY=YOUR_PUBLIC_KEY_HERE

# EMAIL
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=CrashBot <contato@crashbot.com>

# TELEGRAM
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
